<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="POSTTEST1"/>
        <attribute name="authors" value="USER"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-15 01:48:20 PM"/>
        <attribute name="created" value="VVNFUjtERVNLVE9QLUlFR0FINDQ7MjAyNi0wOS0xNTsxMTozODo1NyBBTTsyNjM1"/>
        <attribute name="edited" value="VVNFUjtERVNLVE9QLUlFR0FINDQ7MjAyNi0wOS0xNTswMTo0ODoyMCBQTTsxNjsyODAy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="namaPelanggan" type="String" array="False" size=""/>
            <declare name="level, hargaMie, biayaTambahan, totalSebelumPajak" type="Integer" array="False" size=""/>
            <declare name="pajak, totalAkhir, uangBayar, kembalian, kekurangan" type="Real" array="False" size=""/>
            <output expression="&quot;Selamat datang, silahkan masukkan nama anda&quot;" newline="True"/>
            <input variable="namaPelanggan"/>
            <output expression="&quot;Pilih level kepedasan&quot;" newline="True"/>
            <input variable="level"/>
            <output expression="&quot;Silahkan lakukan pembayaran&quot;" newline="True"/>
            <assign variable="hargaMie" expression="20000"/>
            <if expression="level &lt;= 1">
                <then>
                    <assign variable="biayaTambahan" expression="0"/>
                </then>
                <else>
                    <if expression="level &lt;= 3">
                        <then>
                            <assign variable="biayaTambahan" expression="4000"/>
                        </then>
                        <else>
                            <assign variable="biayaTambahan" expression="6000"/>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="totalSebelumPajak" expression="hargaMie + biayaTambahan"/>
            <assign variable="pajak" expression="totalSebelumPajak * 0.10"/>
            <assign variable="totalAkhir" expression="totalSebelumPajak + pajak"/>
            <input variable="uangBayar"/>
            <if expression="uangBayar &gt;= totalAkhir">
                <then>
                    <assign variable="kembalian" expression="uangBayar - totalAkhir"/>
                    <output expression="&quot;[Pembayaran Berhasi] silahkan menunggu, Chef sedang &#55357;&#56613;memasak&#55357;&#56613;&quot;" newline="True"/>
                    <output expression="&quot;Nama pelanggan : &quot; &amp; namaPelanggan" newline="True"/>
                    <output expression="&quot;Level kepedasan : &quot; &amp; level" newline="True"/>
                    <output expression="&quot;Total sebelum pajak : Rp&quot; &amp; totalSebelumPajak" newline="True"/>
                    <output expression="&quot;Total akhir : Rp&quot; &amp; totalAkhir" newline="True"/>
                    <output expression="&quot;Uang dibayar : Rp&quot; &amp; uangBayar" newline="True"/>
                    <output expression="&quot;Uang kembalian : Rp&quot; &amp; kembalian" newline="True"/>
                </then>
                <else>
                    <assign variable="kekurangan" expression="totalAkhir - uangBayar"/>
                    <output expression="&quot;[Pembayaran Gagal] Minggir lu miskin&quot;" newline="True"/>
                    <output expression="&quot;Nama pelanggan : &quot; &amp; namaPelanggan" newline="True"/>
                    <output expression="&quot;Level kepedasan : &quot; &amp; level" newline="True"/>
                    <output expression="&quot;Total sebelum pajak : Rp&quot; &amp; totalSebelumPajak" newline="True"/>
                    <output expression="&quot;Total akhir : Rp&quot; &amp; totalAkhir" newline="True"/>
                    <output expression="&quot;Uang dibayar : Rp&quot; &amp; uangBayar" newline="True"/>
                    <output expression="&quot;Kekurangan : Rp&quot; &amp; kekurangan" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
